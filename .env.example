# Kopier til .env.local og fyll inn.

# Neon, pooled connection (den med "-pooler" i vertsnavnet).
DATABASE_URL="postgresql://bruker:passord@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Neon, direkte connection (uten "-pooler"). Brukes bare av prisma migrate.
DIRECT_URL="postgresql://bruker:passord@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Den delte koden familien logger inn med.
FAMILY_PIN="1234"

# Tilfeldig streng, minst 16 tegn. Signerer innloggingscookien.
# Lag en med: openssl rand -base64 32
AUTH_SECRET="bytt-meg-til-noe-tilfeldig-og-langt"

# Leser opplastede lekseplaner. Hentes fra https://console.anthropic.com
# Uten denne virker resten av appen som før — bare lekseplan-opplasting feiler.
ANTHROPIC_API_KEY="sk-ant-..."
