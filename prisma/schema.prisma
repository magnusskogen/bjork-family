generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Member {
  id      String  @id @default(cuid())
  name    String
  isChild Boolean @default(false)

  meals    MealEntry[] @relation("ChildMeals")
  authored MealEntry[] @relation("MealAuthor")
  notices  Notice[]

  routines         Routine[] @relation("RoutineMember")
  authoredRoutines Routine[] @relation("RoutineAuthor")

  aboutNotices        Notice[]        @relation("NoticeMember")
  aboutPendingNotices PendingNotice[] @relation("PendingNoticeMember")
}

model MealEntry {
  id          String   @id @default(cuid())
  child       Member   @relation("ChildMeals", fields: [childId], references: [id], onDelete: Cascade)
  childId     String
  date        DateTime @db.Date
  text        String
  createdBy   Member   @relation("MealAuthor", fields: [createdById], references: [id])
  createdById String
  updatedAt   DateTime @updatedAt

  @@unique([childId, date])
  @@index([date])
}

/// Hvor beskjeden kommer fra. Familien kan legge til egne underveis, derfor en
/// tabell og ikke en enum. `color` er en nøkkel inn i paletten i globals.css,
/// ikke en hex-verdi — da slipper vi vilkårlige farger i databasen.
model NoticeCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("graa")
  sortOrder Int      @default(100)
  createdAt DateTime @default(now())

  notices        Notice[]
  pendingNotices PendingNotice[]
  routines       Routine[]

  @@index([sortOrder])
}

model Notice {
  id         String         @id @default(cuid())
  date       DateTime       @db.Date
  category   NoticeCategory @relation(fields: [categoryId], references: [id])
  categoryId String
  text       String

  /// Hvem beskjeden gjelder. Null betyr hele familien. Med to skolebarn er
  /// «gjør ferdig arket» meningsløst uten et navn på.
  member   Member? @relation("NoticeMember", fields: [memberId], references: [id], onDelete: SetNull)
  memberId String?

  createdBy   Member   @relation(fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([categoryId])
}

/// En avtale som gjentar seg hver uke — trening, korps, svømming.
///
/// Lagres som en regel (ukedag + klokkeslett), ikke som én rad per dato. Da
/// gjelder den til noen fjerner den, og forsiden regner ut forekomstene når
/// uka vises. Prisen er at én enkelt gang ikke kan avlyses; det får bli en
/// vanlig beskjed i stedet.
model Routine {
  id String @id @default(cuid())

  /// 1 = mandag ... 5 = fredag. Samme dager som forsiden viser.
  weekday Int

  /// «HH:MM» i norsk tid, eller null for avtaler uten fast klokkeslett.
  /// Tekst og ikke DateTime — et klokkeslett uten dato er ikke et tidspunkt,
  /// og en `time`-kolonne ville dratt med seg tidssonespørsmål vi ikke har.
  time String?

  text String

  /// Hvem det gjelder. Null betyr hele familien.
  member   Member? @relation("RoutineMember", fields: [memberId], references: [id], onDelete: Cascade)
  memberId String?

  category   NoticeCategory @relation(fields: [categoryId], references: [id])
  categoryId String

  createdBy   Member   @relation("RoutineAuthor", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())

  @@index([weekday])
  @@index([categoryId])
}

/// Et forslag til beskjed som er lest ut av en opplastet lekseplan.
///
/// Ingenting havner i kalenderen uten at et menneske har sett på det: uttrekket
/// lages av en språkmodell, og planene sier sjelden hvilken dag leksa hører til.
/// Derfor er dette et eget mellomsteg og ikke en Notice med det samme.
model PendingNotice {
  id String @id @default(cuid())

  /// Dagen leksa hører til, når planen faktisk sier det («til fredag»).
  /// Null betyr at ingen dag var oppgitt, og at et menneske må velge.
  date DateTime? @db.Date

  /// Faget raden kom fra — «Matte», «Tysk». Blir ledetekst i beskjeden.
  subject String?

  category   NoticeCategory? @relation(fields: [categoryId], references: [id])
  categoryId String?
  text       String

  /// Hvem planen gjaldt. Velges ved opplasting, ikke av modellen.
  member   Member? @relation("PendingNoticeMember", fields: [memberId], references: [id], onDelete: Cascade)
  memberId String?

  /// Rådataene modellen svarte med. Ligger her så en rar tolkning kan
  /// ettergås uten å laste opp planen på nytt.
  rawSource String
  status    PendingNoticeStatus @default(FORESLATT)
  createdAt DateTime            @default(now())

  @@index([status])
}

enum PendingNoticeStatus {
  FORESLATT
  GODKJENT
  AVVIST
}
